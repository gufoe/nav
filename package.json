{
  "name": "nav",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "ui",
    "backend"
  ],
  "scripts": {
    "dev": "./dev",
    "dev:watch": "concurrently -n ui,api -c cyan,magenta \"npm run dev -w nav-ui\" \"npm run dev -w nav-backend\"",
    "dev:ui": "npm run dev -w nav-ui",
    "dev:backend": "npm run dev -w nav-backend",
    "build": "npm run build -w nav-ui",
    "test": "npm run test -w nav-ui",
    "test:unit": "npm run test:unit -w nav-ui",
    "test:physics": "npm run test:physics -w nav-ui",
    "physics:report": "npm run physics:report -w nav-ui"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
